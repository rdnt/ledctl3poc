{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "window_size": {
      "type": "integer",
      "default": 10,
      "minimum": 1
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "#000000",
        "#aaaaaa"
      ],
      "minLength": 2
    }
  },
  "required": [
    "window_size",
    "colors"
  ]
}
